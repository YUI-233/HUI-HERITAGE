{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "db:verify": "node scripts/verify-prisma.cjs",
    "admin:verify": "tsx scripts/verify-admin-catalog.ts",
    "import:verify": "tsx scripts/verify-import-preview.ts",
    "personal-import:verify": "tsx scripts/verify-personal-holdings-import.ts",
    "review-workflow:verify": "tsx scripts/verify-import-review-workflow.ts",
    "holding-deletion:verify": "tsx scripts/verify-holding-deletion-workflow.ts",
    "catalog-review:verify": "tsx scripts/verify-catalog-review-workflow.ts",
    "catalog-metadata:verify": "tsx scripts/verify-catalog-metadata.ts",
    "media:verify": "tsx scripts/verify-admin-media.ts",
    "auth:verify": "tsx scripts/verify-auth-admin.ts",
    "member-media:verify": "tsx scripts/verify-member-media.ts",
    "borrowing:verify": "tsx scripts/verify-borrowing.ts",
    "profile:verify": "tsx scripts/verify-personal-collection-profile.ts",
    "cloud:export:public": "tsx scripts/export-cloud-public-data.ts",
    "cloud:seed:generate": "tsx scripts/generate-cloud-seed.ts",
    "dev:postgres": "node scripts/run-next-postgres.cjs dev",
    "build:postgres": "next build",
    "start:postgres": "next start --port 3014"
    ,"db:start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1"
    ,"dev:local": "npm run db:start:local && npm run dev:postgres"
  },
  "dependencies": {
    "@ditojs/tiptap-footnotes": "^3.0.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-horizontal-rule": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-subscript": "^3.30.2",
    "@tiptap/extension-superscript": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-table-cell": "^3.30.2",
    "@tiptap/extension-table-header": "^3.30.2",
    "@tiptap/extension-table-row": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "drizzle-orm": "0.45.2",
    "mammoth": "^1.12.1",
    "next": "16.2.6",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
